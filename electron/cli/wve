#!/bin/sh
# Runs wve.js on the app's own runtime, so Node doesn't need to be installed.
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$DIR/../../worksuite-frameflow" ]; then APP="$DIR/../../worksuite-frameflow"
elif [ -x "$DIR/../../MacOS/Worksuite FrameFlow" ]; then APP="$DIR/../../MacOS/Worksuite FrameFlow"
else exec node "$DIR/wve.js" "$@"; fi
ELECTRON_RUN_AS_NODE=1 exec "$APP" "$DIR/wve.js" "$@"
