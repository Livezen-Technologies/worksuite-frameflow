{
  "name": "worksuite-frameflow",
  "productName": "Worksuite FrameFlow",
  "version": "1.0.0",
  "description": "Worksuite FrameFlow — desktop app (based on OpenCut)",
  "author": {
    "name": "Livezen Technologies",
    "email": "support@worksuitecloud.com"
  },
  "license": "MIT",
  "homepage": "https://worksuitecloud.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Livezen-Technologies/worksuite-frameflow.git"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-web": "node scripts/prepare-web.mjs",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.worksuitecloud.frameflow",
    "productName": "Worksuite FrameFlow",
    "copyright": "Copyright © 2026 Livezen Technologies. Based on OpenCut (MIT).",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "account.js",
      "cloud-upload.js",
      "cloud-sync.js",
      "updater.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Worksuite-FrameFlow-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Worksuite-FrameFlow-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "executableName": "worksuite-frameflow",
      "maintainer": "Livezen Technologies",
      "artifactName": "Worksuite-FrameFlow-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://download.worksuitecloud.com/frameflow/stable",
        "channel": "latest"
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
