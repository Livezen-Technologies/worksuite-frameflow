{
  "name": "worksuite-video-editor",
  "productName": "Worksuite Video Editor",
  "version": "1.0.0",
  "description": "Worksuite Video Editor \u2014 desktop app (based on OpenCut)",
  "author": {
    "name": "Livezen Technologies",
    "email": "support@worksuitecloud.com"
  },
  "license": "MIT",
  "homepage": "https://worksuitecloud.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Livezen-Technologies/worksuite-frameflow.git"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-web": "node scripts/prepare-web.mjs",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.worksuitecloud.video",
    "productName": "Worksuite Video Editor",
    "copyright": "Copyright \u00a9 2026 Livezen Technologies. Based on OpenCut (MIT).",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Worksuite-Video-Editor-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Worksuite-Video-Editor-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "executableName": "worksuite-video",
      "maintainer": "Livezen Technologies",
      "artifactName": "Worksuite-Video-Editor-${version}-linux-${arch}.${ext}"
    }
  }
}
