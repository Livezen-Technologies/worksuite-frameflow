{
  "name": "worksuite-frameflow",
  "productName": "Worksuite FrameFlow",
  "version": "1.1.0",
  "description": "Worksuite FrameFlow — video editor desktop app",
  "author": {
    "name": "Livezen Technologies",
    "email": "support@worksuitecloud.com"
  },
  "license": "MIT",
  "homepage": "https://worksuitecloud.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Livezen-Technologies/worksuite-frameflow.git"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-web": "node scripts/prepare-web.mjs",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.worksuitecloud.frameflow",
    "productName": "Worksuite FrameFlow",
    "copyright": "Copyright © 2026 Livezen Technologies.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "account.js",
      "cloud-upload.js",
      "cloud-sync.js",
      "updater.js",
      "asset-store.js",
      "asset-pack-io.js",
      "capture.js",
      "network.js",
      "upload-queue.js",
      "project-folders.js",
      "ai.js",
      "ai-providers.js",
      "automation.js",
      "automation-grpc.js",
      "automation.proto",
      "preload.js",
      "package.json",
      "native-helper.js",
      "cursor-log.js",
      "capture-controls.js",
      "privacy.js",
      "capture-bar/**",
      "project-windows.js",
      "master-export.js"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      },
      {
        "from": "../LICENSE",
        "to": "licenses/OpenCut-LICENSE.txt"
      },
      {
        "from": "../node_modules/libheif-js/LICENSE",
        "to": "licenses/libheif-js-LGPL-3.0.txt"
      },
      {
        "from": "cli",
        "to": "cli",
        "filter": [
          "wve.js",
          "wve",
          "wve.cmd"
        ]
      },
      {
        "from": "vendor/ffmpeg/${platform}-${arch}",
        "to": "ffmpeg"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "licenses/THIRD-PARTY-NOTICES.md"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Worksuite-FrameFlow-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FrameFlow records voiceovers and your microphone during screen recordings.",
        "NSCameraUsageDescription": "FrameFlow records your camera during screen recordings."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Worksuite-FrameFlow-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "executableName": "worksuite-frameflow",
      "maintainer": "Livezen Technologies",
      "artifactName": "Worksuite-FrameFlow-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://download.worksuitecloud.com/frameflow/stable",
        "channel": "latest"
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "electron-updater": "6.6.2",
    "uiohook-napi": "1.5.4"
  }
}
