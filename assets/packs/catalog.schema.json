{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://download.worksuitecloud.com/assets/catalog.schema.json",
	"title": "Worksuite asset catalog",
	"description": "catalog.json at <ASSET_BASE>/<channel>/. Signed by catalog.json.sig (base64 Ed25519 over the exact bytes).",
	"type": "object",
	"required": ["schema", "channel", "packs"],
	"properties": {
		"schema": { "const": 1 },
		"channel": { "enum": ["stable", "beta"] },
		"generatedAt": { "type": "string", "format": "date-time" },
		"packs": { "type": "array", "items": { "$ref": "#/$defs/pack" } }
	},
	"$defs": {
		"semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
		"pack": {
			"type": "object",
			"required": ["id", "type", "version", "title", "description", "tags", "languages", "sizeBytes", "sha256", "licence", "minAppVersion", "files", "plan"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
				"type": { "enum": ["motion", "text-animations", "text-templates", "video-templates", "sounds", "transitions", "effects", "filters", "color-profiles", "luts", "fonts"] },
				"version": { "$ref": "#/$defs/semver" },
				"title": { "type": "string", "minLength": 1 },
				"description": { "type": "string", "minLength": 1 },
				"tags": {
					"type": "object",
					"properties": { "en": { "type": "array", "items": { "type": "string" } }, "si": { "type": "array", "items": { "type": "string" } }, "ta": { "type": "array", "items": { "type": "string" } } }
				},
				"languages": { "type": "array", "items": { "type": "string" } },
				"sizeBytes": { "type": "integer", "minimum": 1 },
				"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"licence": { "type": "string", "minLength": 1 },
				"minAppVersion": { "$ref": "#/$defs/semver" },
				"thumbnailUrl": { "type": ["string", "null"] },
				"previewUrl": { "type": ["string", "null"] },
				"files": { "type": "string", "description": "Zip URL, absolute or relative to catalog.json" },
				"plan": { "enum": ["free", "pro"] },
				"assetCount": { "type": "integer", "minimum": 0 },
				"assetIds": { "type": "array", "items": { "type": "string" } },
				"builtin": { "type": "boolean", "description": "Also bundled with the app (shown as Installed (built-in))" }
			}
		}
	}
}
